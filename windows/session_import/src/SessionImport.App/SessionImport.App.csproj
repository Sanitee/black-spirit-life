<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <DebugType>none</DebugType>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Session Import</AssemblyName>
    <RootNamespace>BlackSpiritLife.SessionImport.App</RootNamespace>
    <ApplicationIcon>session-import.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <ProjectReference Include="..\SessionImport.Protocol\SessionImport.Protocol.csproj" />
    <ProjectReference Include="..\SummaryOcr\SummaryOcr.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="session-import.ico" />
    <Resource Include="..\..\..\..\assets\app\black_spirit_life_icon.png" Link="Assets\black_spirit_life_icon.png" />
    <InternalsVisibleTo Include="SessionImport.Tests" />
    <EmbeddedResource Include="..\..\browser_extension\tracker_helper\protocol.js" LogicalName="BlackSpiritLife.SessionImport.App.Garmoth.protocol.js" />
    <EmbeddedResource Include="..\..\browser_extension\tracker_helper\content.js" LogicalName="BlackSpiritLife.SessionImport.App.Garmoth.content.js" />
  </ItemGroup>
</Project>
