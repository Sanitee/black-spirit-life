<Window x:Class="BlackSpiritLife.SessionImport.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Session Import · Black Spirit Life" Icon="session-import.ico"
        Width="920" Height="690" MinWidth="920" MinHeight="690"
        WindowStartupLocation="CenterScreen" Background="#0B1211"
        Style="{StaticResource {x:Type Window}}">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="SpotPickerResources.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <Grid Margin="22" Background="#0B1211">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="16" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="14" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource AccentDark}" Margin="0,0,12,0">
          <Image x:Name="AppArtwork" Source="Assets/black_spirit_life_icon.png" Width="32" Height="32"
                 Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" />
        </Border>
        <StackPanel>
          <TextBlock Text="Session Import" FontSize="23" FontWeight="SemiBold" />
          <TextBlock Text="Black Spirit Life · IQON summaries" Foreground="{StaticResource Muted}" FontSize="12.5" />
        </StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,0">
        <TextBlock Text="Duration" FontSize="14" VerticalAlignment="Center" Margin="0,0,9,0" />
        <TextBox x:Name="DurationBox" Text="01:00" Width="86" FontSize="16" Padding="10,6"
                 HorizontalContentAlignment="Center" AutomationProperties.Name="Duration, hours and minutes" />
      </StackPanel>
      <Button Grid.Column="2" x:Name="FirefoxSetupButton" Click="FirefoxSetupButton_Click" Padding="11,7">
        <Button.ContextMenu>
          <ContextMenu>
            <MenuItem x:Name="SwitchBrowserMenuItem" Header="Use Firefox instead" Click="SwitchBrowserButton_Click" />
          </ContextMenu>
        </Button.ContextMenu>
        <StackPanel Orientation="Horizontal">
          <Ellipse x:Name="BrowserStatusDot" Width="8" Height="8" Fill="#738079" Margin="0,0,8,0" />
          <TextBlock x:Name="BrowserStatusText" Text="Garmoth login" Foreground="{StaticResource Text}" />
        </StackPanel>
      </Button>
    </Grid>

    <Border Grid.Row="2" x:Name="SetupPanel" Visibility="Collapsed" Margin="0,0,0,14"
            Padding="14" Background="{StaticResource SurfaceRaised}" BorderBrush="{StaticResource Border}"
            BorderThickness="1" CornerRadius="10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <StackPanel x:Name="FirefoxHelp">
          <TextBlock Text="Connect to Garmoth through Firefox" FontSize="15" FontWeight="SemiBold" />
          <TextBlock Text="1. Open Firefox setup below. The add-on file path is copied for you."
                     Margin="0,8,0,4" TextWrapping="Wrap" />
          <TextBlock Text="2. Choose Load Temporary Add-on… and paste the path into the file picker."
                     TextWrapping="Wrap" />
          <WrapPanel Margin="0,10,0,8">
            <Button x:Name="SetupOpenButton" Content="Open Firefox setup" Click="SetupOpenButton_Click" Margin="0,0,8,0" />
            <Button x:Name="SetupCopyButton" Content="Copy add-on path" Click="SetupCopyButton_Click" />
          </WrapPanel>
          <TextBlock x:Name="SetupStatusText" Foreground="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap" />
          <TextBlock Text="Allow garmoth.com access if asked. Repeat after restarting Firefox."
                     Foreground="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap" Margin="0,4,0,0" />
          </StackPanel>
          <Button x:Name="SwitchBrowserButton" Content="Use Firefox instead" Click="SwitchBrowserButton_Click"
                  Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,10,0,0"
                  Padding="0,4" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Muted}" />
        </StackPanel>
        <Button Grid.Column="1" Content="×" Click="SetupCloseButton_Click" VerticalAlignment="Top"
                Padding="8,3" Margin="8,0,0,0" AutomationProperties.Name="Close connection help" />
      </Grid>
    </Border>

    <Border Grid.Row="3" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
            BorderThickness="1" CornerRadius="12" Padding="18">
      <Grid>
        <Grid x:Name="EmptyPanel">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Width="64" Height="64" CornerRadius="16" Background="{StaticResource AccentDark}" HorizontalAlignment="Center">
              <TextBlock Text="▣" FontSize="30" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="Paste a session screenshot" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,16" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
              <Button Style="{StaticResource PrimaryButton}" Content="Paste screenshot" Click="PasteButton_Click" Margin="0,0,10,0" />
              <Button Content="Open image" Click="OpenButton_Click" />
            </StackPanel>
            <TextBlock Text="IQON summary screenshots are read locally." Foreground="{StaticResource Muted}"
                       FontSize="12.5" HorizontalAlignment="Center" Margin="0,14,0,0" />
          </StackPanel>
        </Grid>

        <Grid x:Name="ReviewPanel" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Width="220">
              <TextBlock x:Name="SpotLabel" Text="Spot" Foreground="{StaticResource Muted}" FontSize="12" Margin="2,0,0,5" />
              <Grid>
                <!-- Exact typed names are resolved before preparing. Native text search
                     would silently choose the first of same-name gathering methods. -->
                <ComboBox x:Name="SpotBox" IsEditable="True" IsTextSearchEnabled="False" TextSearch.TextPath="Name"
                          Style="{StaticResource SessionChoice}" MaxDropDownHeight="360" AutomationProperties.Name="Spot"
                          Tag="{Binding SelectedItem, RelativeSource={RelativeSource Self}, Converter={StaticResource SpotArtwork}}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <Grid MinWidth="280" MaxWidth="380">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="36" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image Source="{Binding Converter={StaticResource SpotArtwork}}" Width="28" Height="28"
                               HorizontalAlignment="Left" VerticalAlignment="Center" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                          <TextBlock Text="{Binding Name}" FontSize="14" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Converter={StaticResource SpotCategory}}" FontSize="11.5" Foreground="{StaticResource Muted}" Margin="0,2,0,0" />
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="Choose or type a spot" Foreground="#6F7F78" Margin="11,0,30,0"
                           VerticalAlignment="Center" IsHitTestVisible="False">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Text, ElementName=SpotBox}" Value="">
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </Grid>
            </StackPanel>
            <StackPanel Grid.Column="2" Width="80">
              <TextBlock Text="Agris" Foreground="{StaticResource Muted}" FontSize="12" Margin="2,0,0,5" />
              <ComboBox x:Name="AgrisActiveBox" SelectedIndex="0" AutomationProperties.Name="Agris" Style="{StaticResource SessionChoice}">
                <ComboBoxItem Content="No" />
                <ComboBoxItem Content="Yes" />
              </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="4">
              <TextBlock Text="Additional drop rate %" Foreground="{StaticResource Muted}" FontSize="12" Margin="2,0,0,5" />
              <TextBox x:Name="AdditionalDropRateBox" Width="80" HorizontalAlignment="Left" FontSize="14"
                       AutomationProperties.Name="Additional drop rate percent" />
            </StackPanel>
            <StackPanel Grid.Column="6">
              <TextBlock Text="Additional drop amount %" Foreground="{StaticResource Muted}" FontSize="12" Margin="2,0,0,5" />
              <TextBox x:Name="AdditionalDropAmountBox" Width="80" HorizontalAlignment="Left" FontSize="14"
                       AutomationProperties.Name="Additional drop amount percent" />
            </StackPanel>
            <Button Grid.Column="8" x:Name="NewScreenshotButton" Content="New screenshot" Click="ResetButton_Click"
                    Margin="12,21,0,0" VerticalAlignment="Top" />
          </Grid>

          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="LootItems" ItemsSource="{Binding LootRows}"
                          HorizontalAlignment="Left" VerticalAlignment="Top">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Width="190" Height="82" Margin="0,0,7,7" Padding="6"
                          CornerRadius="9" Background="{StaticResource SurfaceRaised}" BorderBrush="{StaticResource Border}" BorderThickness="1">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="38" />
                        <RowDefinition Height="*" />
                      </Grid.RowDefinitions>
                      <Border Width="34" Height="34" CornerRadius="7" Background="#0B1412" VerticalAlignment="Top">
                        <Grid>
                          <Image Source="{Binding IconPath}" Width="32" Height="32" Stretch="Uniform" />
                          <TextBlock Text="◆" Foreground="#607A70" HorizontalAlignment="Center" VerticalAlignment="Center"
                                     Visibility="{Binding PlaceholderVisibility}" />
                        </Grid>
                      </Border>
                      <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                               Margin="2,0,1,2" BorderThickness="0" Background="Transparent" Padding="0"
                               FontSize="12" TextWrapping="Wrap" AcceptsReturn="False"
                               HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled" />
                      <Button Grid.Column="2" Content="×" Tag="{Binding}" Click="RemoveLootButton_Click"
                              Padding="2" Margin="2,0,0,12" />
                      <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                               Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                               Padding="6,3" Height="28" HorizontalContentAlignment="Right"
                               PreviewTextInput="NumberOnly_PreviewTextInput" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Grid>
    </Border>

    <Grid Grid.Row="5">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
        <TextBlock x:Name="StatusText" Text="Screenshots are not saved." Foreground="{StaticResource Muted}"
                   TextWrapping="Wrap" Margin="0,0,16,0" VerticalAlignment="Center" />
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button x:Name="AddItemButton" Content="+ Item" Click="AddItemButton_Click" Visibility="Collapsed" Margin="0,0,10,0" />
          <Button x:Name="PrepareButton" Style="{StaticResource PrimaryButton}" Content="Send to Garmoth"
                Click="PrepareButton_Click" Visibility="Collapsed" MinWidth="170" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
