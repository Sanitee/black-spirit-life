#include <windows.h>
#include "resource.h"

IDI_BLACK_SPIRIT_LIFE ICON "@BSL_APP_ICON@"

IDR_SAKURA_CEDAR RCDATA "@BSL_SAKURA_CEDAR@"
IDR_SAKURA_LACQUER RCDATA "@BSL_SAKURA_LACQUER@"
IDR_SAKURA_TITLE_SPRIG RCDATA "@BSL_SAKURA_TITLE_SPRIG@"

@BSL_ENGINE_RESOURCE_LINE@

1 RT_MANIFEST "@BSL_INSTALLER_MANIFEST@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @BSL_INSTALLER_VERSION_MAJOR@,@BSL_INSTALLER_VERSION_MINOR@,@BSL_INSTALLER_VERSION_PATCH@,@BSL_INSTALLER_BUILD_NUMBER@
 PRODUCTVERSION @BSL_INSTALLER_VERSION_MAJOR@,@BSL_INSTALLER_VERSION_MINOR@,@BSL_INSTALLER_VERSION_PATCH@,@BSL_INSTALLER_BUILD_NUMBER@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Black Spirit Life\0"
      VALUE "FileDescription", "Black Spirit Life Installer\0"
      VALUE "FileVersion", "@BSL_INSTALLER_VERSION@.@BSL_INSTALLER_BUILD_NUMBER@\0"
      VALUE "InternalName", "BlackSpiritLifeInstaller\0"
      VALUE "OriginalFilename", "BlackSpiritLifeInstaller.exe\0"
      VALUE "ProductName", "Black Spirit Life Installer\0"
      VALUE "ProductVersion", "@BSL_INSTALLER_VERSION@+@BSL_INSTALLER_BUILD_NUMBER@\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
